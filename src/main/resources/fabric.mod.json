{
  "schemaVersion": 1,
  "id": "tradeoptimizer",
  "version": "${version}",
  "name": "Trade Optimizer",
  "description": "In-merchant trade rating overlay + targeted villager cycling. Pick the trade you want, watch the mod cycle the workstation until it shows up, then re-roll for the best price.",
  "authors": ["polyvenom"],
  "contact": {
    "homepage": "https://github.com/polyvenom",
    "sources": "https://github.com/polyvenom"
  },
  "license": "MIT",
  "icon": "assets/tradeoptimizer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.tom.tradeoptimizer.TradeOptimizer"
    ],
    "client": [
      "com.tom.tradeoptimizer.client.TradeOptimizerClient"
    ]
  },
  "mixins": [
    {
      "config": "tradeoptimizer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=26.1.2",
    "java": ">=25"
  }
}
