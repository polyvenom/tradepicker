{
  "schemaVersion": 1,
  "id": "tradeoptimizer",
  "version": "${version}",
  "name": "Trade Picker",
  "description": "Pick the exact villager trades you want, at vanilla's lowest price. Choose two trades from the full pool at each level, no workstation breaking or RNG. Reset any villager to start over.",
  "authors": ["polyvenom"],
  "contact": {
    "homepage": "https://github.com/polyvenom/tradepicker",
    "sources": "https://github.com/polyvenom/tradepicker"
  },
  "license": "CC0-1.0",
  "icon": "assets/tradeoptimizer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.tom.tradeoptimizer.fabric.TradeOptimizerFabric"
    ],
    "client": [
      "com.tom.tradeoptimizer.client.TradeOptimizerClient"
    ],
    "modmenu": [
      "com.tom.tradeoptimizer.client.modmenu.TradePickerMenuApi"
    ]
  },
  "mixins": [
    {
      "config": "tradeoptimizer.mixins.json"
    },
    {
      "config": "tradeoptimizer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25"
  },
  "recommends": {
    "modmenu": "*"
  }
}
